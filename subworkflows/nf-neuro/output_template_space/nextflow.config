process {
    // Masks and labelmaps must not be interpolated linearly (the module default): a linearly
    // warped mask is fractional at its border and a linearly warped labelmap averages label numbers.
    withName: '.*OUTPUT_TEMPLATE_SPACE:WARPMASK' {
        ext.interpolation = "NearestNeighbor"
    }
    withName: '.*OUTPUT_TEMPLATE_SPACE:WARPLABELS' {
        ext.interpolation = "GenericLabel"
    }
}
