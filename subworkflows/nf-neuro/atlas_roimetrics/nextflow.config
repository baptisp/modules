process {
    withName: '.*ATLAS_ROIMETRICS:TRANSFORM_IIT_GM_ATLAS' {
        // A labelmap: GenericLabel keeps every voxel an existing label. Linear (the module default)
        // averages label numbers at region borders, and MultiLabel alters label volumes even under
        // an identity transform.
        ext.dimensionality = 3
        ext.image_type     = 0
        ext.interpolation  = "GenericLabel"
        ext.output_dtype   = "short"
        ext.default_val    = 0
    }
}

includeConfig '../atlas_iit/nextflow.config'
