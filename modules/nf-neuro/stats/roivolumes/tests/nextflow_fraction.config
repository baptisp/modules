process {
    withName: "IMAGE_MATH" {
        ext.operation = "multiplication"
        ext.prefix    = { meta.id }
        ext.suffix    = "half"
    }
    withName: "STATS_ROIVOLUMES" {
        publishDir = { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }
        ext.prefix = { meta.id }
        ext.use_label = false
    }
}
