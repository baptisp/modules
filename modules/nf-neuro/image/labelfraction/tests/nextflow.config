process {
    withName: "IMAGE_LABELFRACTION" {
        publishDir = { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }
        ext.prefix = { meta.id }
        ext.supersampling = 2   // 1 mm test grids: keeps the tests short
    }
    withName: "IMAGE_RESAMPLE" {
        ext.voxel_size = 2
        ext.interp     = "lin"
    }
}
